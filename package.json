{
  "name": "brandonreiss-site",
  "version": "1.0.0",
  "private": true,
  "description": "Source and build pipeline for https://brandonreiss.com",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-applets.mjs && node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/serve.mjs",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry": "./scripts/deploy.sh --dry-run",
    "set-cache": "node scripts/set-cache.mjs",
    "sync-resume": "node scripts/sync-resume.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "live-server": "^1.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
